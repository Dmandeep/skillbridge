# ==============================================================================
# SKILLBRIDGE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# NOTICE:
# Variables prefixed with VITE_ are embedded into the client bundle during build.
# NEVER store private secrets, database passwords, or private signing keys here.
# ==============================================================================

# Application Metadata
VITE_APP_NAME=SkillBridge
VITE_APP_TAGLINE="Skills Demonstrated. Talent Verified. Opportunities Connected."
VITE_APP_VERSION=1.7.0

# Motion & Interaction Flags
VITE_ENABLE_CINEMATIC_INTRO=true
VITE_DEFAULT_THEME=auto

# Planned Java Spring Boot + MySQL Backend Service (Phase 4 Roadmap)
# VITE_API_BASE_URL=https://api.skillbridge.io/api/v1
# VITE_GVISOR_RUNNER_GATEWAY=https://runner.skillbridge.io/execute
